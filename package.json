{
  "name": "carbon-studio",
  "version": "0.3.1",
  "private": true,
  "description": "Editor Carbon para Windows: Carbon → LaTeX → PDF",
  "author": "Carbon Studio",
  "license": "MIT",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "electron .",
    "test": "node --test tests/core.test.cjs tests/carbon.test.cjs tests/layout.test.cjs tests/alignment.test.cjs tests/workspace.test.cjs tests/features.test.cjs",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e.test.cjs tests/layout-e2e.test.cjs tests/alignment-e2e.test.cjs tests/features-e2e.test.cjs",
    "prepare:compiler": "node scripts/prepare-compiler.cjs",
    "dist:win": "node scripts/build-win.cjs",
    "pack:win": "node scripts/build-win.cjs --dir",
    "test:packaged": "node --test tests/packaged.test.cjs",
    "create:icon": "electron scripts/create-icon.cjs",
    "test:workspace:dev": "node --test tests/workspace-dev-e2e.test.cjs"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "mermaid": "12.2.0",
    "monaco-editor": "0.57.0",
    "pdfjs-dist": "6.5.438",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "org.carbonlang.studio",
    "productName": "Carbon Studio",
    "copyright": "Copyright © 2026 Carbon Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "dist/**",
      "package.json",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "build/tectonic.exe",
        "to": "compiler/tectonic.exe"
      },
      {
        "from": "examples",
        "to": "examples"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE-carbon.txt"
      },
      {
        "from": "LANGUAGE.md",
        "to": "LANGUAGE.md"
      },
      {
        "from": "node_modules/monaco-editor/LICENSE",
        "to": "licenses/monaco-editor-LICENSE.txt"
      },
      {
        "from": "node_modules/monaco-editor/ThirdPartyNotices.txt",
        "to": "licenses/monaco-editor-ThirdPartyNotices.txt"
      },
      {
        "from": "node_modules/pdfjs-dist/LICENSE",
        "to": "licenses/pdfjs-LICENSE.txt"
      },
      {
        "from": "assets/themes",
        "to": "themes"
      },
      {
        "from": "node_modules/mermaid/LICENSE",
        "to": "licenses/mermaid-LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "Carbon-Studio-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Carbon-Studio-${version}-${arch}-Setup.${ext}",
      "differentialPackage": false,
      "preCompressedFileExtensions": null
    },
    "fileAssociations": [
      {
        "ext": "cb",
        "name": "Carbon document",
        "description": "Documento Carbon",
        "role": "Editor",
        "icon": "build/icon.ico"
      }
    ],
    "publish": null,
    "portable": {
      "artifactName": "Carbon-Studio-${version}-${arch}-Portable.${ext}"
    },
    "electronDist": "node_modules/electron/dist"
  }
}
